# frozen_string_literal: true

class EnableSecretRotation < ActiveRecord::Migration<%= migration_version %>
  def change
    # The secret superseded by the last `#rotate_secret!`, kept usable until
    # the application calls `#clear_old_secret!`. Stored by the same secret
    # strategy as `secret`, so mirror that column if you widened it (e.g. to
    # `:text` for a custom generator producing long secrets) — and if you
    # declared `secret` with Active Record Encryption, declare
    # `encrypts :old_secret` too: the rotation copies the value through the
    # attribute reader, which is to say decrypted.
    add_column :oauth_applications, :old_secret, :string, null: true

    # When the secret above was retained. `secret_rotation_grace_period`
    # measures its deadline from here; left unset, Doorkeeper expires nothing
    # and the grace period ends when the application calls `#clear_old_secret!`.
    add_column :oauth_applications, :old_secret_created_at, :datetime, null: true

    # Indexed because a job ending grace periods on a deadline selects on it
    # (see the README), and that is a range query over every application.
    add_index :oauth_applications, :old_secret_created_at

    # `old_secret` itself is deliberately not indexed: it is only ever
    # compared against after the client has been found by its `uid`, never
    # looked up by value.
  end
end
