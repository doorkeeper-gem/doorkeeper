# frozen_string_literal: true

class EnableSecretRotation < ActiveRecord::Migration<%= migration_version %>
  def change
    # The secret superseded by the last `#rotate_secret!`, stored by the same
    # secret strategy as `secret`: mirror that column if you widened it, and
    # declare `encrypts :old_secret` if `secret` uses Active Record Encryption.
    add_column :oauth_applications, :old_secret, :string, null: true

    # When the secret above was retained; `secret_rotation_grace_period`
    # measures its deadline from here.
    add_column :oauth_applications, :old_secret_created_at, :datetime, null: true

    # A job ending grace periods on a deadline selects on it. `old_secret`
    # is not indexed: it is only compared after the client is found by `uid`.
    add_index :oauth_applications, :old_secret_created_at
  end
end
